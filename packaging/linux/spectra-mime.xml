<?xml version="1.0" encoding="UTF-8"?>
<!-- File types Spectra opens (spectra.desktop MimeType=); installed to
     share/mime/packages so desktops can offer "Open with Spectra". -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-spectra-layout">
    <comment>Spectra layout</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.spectra"/>
  </mime-type>
  <mime-type type="application/x-ulog">
    <comment>PX4 ULog flight log</comment>
    <glob pattern="*.ulg"/>
    <magic priority="50">
      <match type="string" offset="0" value="ULog"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-mcap">
    <comment>MCAP log</comment>
    <glob pattern="*.mcap"/>
  </mime-type>
</mime-info>
